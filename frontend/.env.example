# Copy to .env.local and adjust. All variables are optional.

# Base URL of the Thicket API. Leave empty to use same-origin requests; the
# Vite dev server proxies /api to http://localhost:8000.
VITE_API_BASE_URL=

# Show experimental models (and the Combined option) in the model selector.
# Experimental models (badged) are shown unless this is false.
VITE_ENABLE_EXPERIMENTAL_MODELS=true

# Static demo build: no uploads, loads precomputed analyses from public/demo/.
VITE_DEMO_MODE=false

# Base path the app is served from, for example /thicket/ on GitHub Pages.
VITE_BASE_PATH=/

# Dev server only: where /api is proxied to.
VITE_DEV_API_PROXY=http://localhost:8000
