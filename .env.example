# Thicket configuration for docker compose (copied into the container as
# environment variables) and for running the backend from the repo root.
# Copy to .env. Every value below is the default unless noted.
# Ports: the API listens on 8000; the Vite dev server runs on 5173.
# In the Docker image THICKET_DATA_DIR=/data, SERVE_FRONTEND_DIR=/app/frontend/dist
# and ENVIRONMENT=production are preset.
# Frontend build variables (VITE_*) live in frontend/.env.example.

# --- Deployment -------------------------------------------------------------
# development | test | production
ENVIRONMENT=development
# Defaults to the installed package version.
# APP_VERSION=0.1.0
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# json (one JSON object per line) | text
LOG_FORMAT=json

# --- Storage ----------------------------------------------------------------
# Data folder for the database, temp files, previews and spectrograms.
# Default: backend/var (resolved to an absolute path).
# THICKET_DATA_DIR=/absolute/path/to/var
# Default: sqlite:///<THICKET_DATA_DIR>/thicket.sqlite3. Postgres also works,
# e.g. postgresql+psycopg://user:pass@host/thicket (install the driver).
# DATABASE_URL=
# Serve a built frontend (frontend/dist) at / with SPA fallback.
# SERVE_FRONTEND_DIR=
# Where the dual-output BirdNET model is cached (default ~/.cache/thicket).
# THICKET_CACHE_DIR=

# --- HTTP -------------------------------------------------------------------
# Comma-separated or JSON list of exact origins. Wildcards are rejected.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# POST requests per client IP per minute (token bucket). 0 disables.
RATE_LIMIT_PER_MINUTE=30
# Header the edge proxy sets to the client IP, used as the rate-limit key
# (Fly-Client-IP on Fly; X-Forwarded-For on Render, where the last entry, the
# one Render's proxy appended, is used). Unset: the connection address.
# CLIENT_IP_HEADER=
# Per-request limit; ?wait=true requests also get ANALYSIS_TIMEOUT_SECONDS.
REQUEST_TIMEOUT_SECONDS=300

# --- Uploads and audio ------------------------------------------------------
# Server-side cap, enforced while streaming (the web app also checks 20 MB).
MAX_UPLOAD_BYTES=52428800
MAX_AUDIO_DURATION_SECONDS=600
MIN_AUDIO_DURATION_SECONDS=1.0

# --- Detection pipeline -----------------------------------------------------
# Default decision threshold when a request does not send one.
DEFAULT_DECISION_THRESHOLD=0.60
# Ingestion floor: raw window scores below it are not stored, so no request
# can use a lower threshold.
RAW_THRESHOLD=0.10
# Windows of one species closer than this merge into one detection event.
MERGE_GAP_SECONDS=1.0
# Window hop: 3.0 (no overlap) or 1.5 (50% overlap).
HOP_SECONDS=3.0

# --- Models -----------------------------------------------------------------
BIRDNET_ENABLED=true
# Folder with BirdNET_GLOBAL_6K_V2.4_Model_FP32.tflite and the labels file.
# Default: the weights bundled in the pinned birdnetlib wheel.
# BIRDNET_MODEL_DIR=
# Range and season plausibility (BirdNET meta model, birds only).
LOCATION_FILTER=true
LOCATION_FILTER_THRESHOLD=0.03
# Experimental frog and insect head on BirdNET embeddings. Keep off until a
# validated model with a benchmark and model card is installed.
FROG_INSECT_ENABLED=false
# FROG_INSECT_MODEL_PATH=/path/to/frog_insect_v1.npz

# --- Retention and workers --------------------------------------------------
# Keep normalized audio after analysis (serves GET /analyses/{id}/audio).
RETAIN_AUDIO=false
# Orphaned temp folders older than this are deleted by the janitor.
TEMP_RETENTION_HOURS=1
PREVIEW_TTL_MINUTES=60
ANALYSIS_TIMEOUT_SECONDS=300
# Concurrent analyses per process. Keep 1 on small instances.
WORKER_CONCURRENCY=1
# How often the janitor runs.
JANITOR_INTERVAL_SECONDS=600

# --- Accounts and sign-in ---------------------------------------------------
# disabled: no login, every request is the local owner of "Local workspace".
# dev: email-only sign-in form for development (refused when ENVIRONMENT=production).
# google: Google sign-in (OpenID Connect, code flow with PKCE).
AUTH_MODE=disabled
# Signs session cookies. Unset: a random secret is generated once and kept in
# <THICKET_DATA_DIR>/session_secret (a warning is logged in production). Set it
# explicitly in production, at least 32 random characters, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# From Google Cloud console > APIs & Services > Credentials (OAuth client, Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public origin of this API. Google redirects to ${PUBLIC_BASE_URL}/api/v1/auth/google/callback,
# which must be listed as an authorized redirect URI. Cookies are Secure when it is https.
PUBLIC_BASE_URL=http://localhost:8000
# Where the web app lives; sign-in and invite links point here (#/ routes).
FRONTEND_URL=http://localhost:5173
# Comma list of email domains allowed to sign in (empty: any verified Google account).
ALLOWED_SIGNIN_DOMAINS=

# --- Email (alert notifications and digests) ----------------------------------
# SMTP with STARTTLS when SMTP_HOST is set (port 465 uses no STARTTLS upgrade).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# e.g. Thicket <no-reply@example.org>; default Thicket <no-reply@thicket.local>
EMAIL_FROM=
# Used instead when SMTP_HOST is empty. With neither, messages are written as
# .eml files to <THICKET_DATA_DIR>/outbox/ for inspection.
RESEND_API_KEY=

# --- Alerts, nightly jobs, batches, reports -------------------------------------
ALERTS_ENABLED=true
# Hour (UTC, 0 to 23) for rollup rebuild, gap checks, digests and cleanup.
NIGHTLY_JOBS_HOUR_UTC=6
# Batch uploads: files per batch (zip contents included) and total bytes (2 GiB).
MAX_BATCH_FILES=200
MAX_BATCH_BYTES=2147483648
# Optional png or jpg printed on report covers.
REPORT_LOGO_PATH=

# --- Uvicorn (read by uvicorn, not by Thicket) -------------------------------
# Trust X-Forwarded-For only from these proxy IPs. Never "*": the client
# controls the left end of that header. Use CLIENT_IP_HEADER for rate limits.
# FORWARDED_ALLOW_IPS=127.0.0.1
