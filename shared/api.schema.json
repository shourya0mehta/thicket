    "DetectionEvent": {
      "additionalProperties": false,
      "description": "One consolidated detection event at the requested decision threshold.\n\n``scientific_name``, ``common_name`` and ``taxon`` are the species the event\ncounts under: the model's label, or the reviewer's correction when an event\nwas corrected to a label the models know. ``detected_*`` always hold the\nmodel's own label, so a correction never hides what the model said.",
      "properties": {
        "common_name": {
          "title": "Common Name",
          "type": "string"
        },
        "contributing_detection_ids": {
          "items": {
            "type": "string"
          },
          "title": "Contributing Detection Ids",
          "type": "array"
        },
        "counted_in_metrics": {
          "description": "True when the event is in the counted set behind species, metrics and charts: a wildlife taxon, not rejected, and not flagged unlikely unless a reviewer accepted or corrected it.",
          "title": "Counted In Metrics",
          "type": "boolean"
        },
        "detected_common_name": {
          "title": "Detected Common Name",
          "type": "string"
        },
        "detected_scientific_name": {
          "description": "The model's label for this event.",
          "title": "Detected Scientific Name",
          "type": "string"
        },
        "detected_taxon": {
          "$ref": "#/$defs/Taxon"
        },
        "end_seconds": {
          "title": "End Seconds",
          "type": "number"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "max_confidence": {
          "description": "Model score for the detected label.",
          "title": "Max Confidence",
          "type": "number"
        },
        "mean_confidence": {
          "title": "Mean Confidence",
          "type": "number"
        },
        "model_run_id": {
          "title": "Model Run Id",
          "type": "string"
        },
        "n_windows": {
          "title": "N Windows",
          "type": "integer"
        },
        "plausibility": {
          "default": "unknown",
          "description": "Range and season check of the detected label; reviews do not change it.",
          "enum": [
            "plausible",
            "unlikely",
            "unknown"
          ],
          "title": "Plausibility",
          "type": "string"
        },
        "review_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review Note"
        },
        "review_status": {
          "$ref": "#/$defs/ReviewStatus",
          "default": "unreviewed"
        },
        "reviewed_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed Label"
        },
        "scientific_name": {
          "description": "Species the event counts under (see detected_*).",
          "title": "Scientific Name",
          "type": "string"
        },
        "start_seconds": {
          "title": "Start Seconds",
          "type": "number"
        },
        "taxon": {
          "$ref": "#/$defs/Taxon"
        }
      },
      "required": [
        "id",
        "scientific_name",
        "common_name",
        "taxon",
        "detected_scientific_name",
        "detected_common_name",
        "detected_taxon",
        "model_run_id",
        "start_seconds",
        "end_seconds",
        "max_confidence",
